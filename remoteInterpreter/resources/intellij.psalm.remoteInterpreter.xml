    <plugin id="com.intellij.php.psalm"/>
    <plugin id="org.jetbrains.plugins.phpstorm-remote-interpreter"/>
    <module name="intellij.php.backend"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.jetbrains.php">
    <tools.quality.Psalm.PsalmConfigurationProvider
      implementation="com.intellij.psalm.remoteInterpreter.PsalmRemoteConfigurationProvider"/>
  </extensions>
</idea-plugin>
